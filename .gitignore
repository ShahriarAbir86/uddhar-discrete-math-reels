# Generated renders (final MP4s go to the Google Drive delivery folder, not Git)
episodes/*/renders/**
!episodes/*/renders/.gitkeep
*.mp4
*.mov
*.png.tmp
frames/

# Dependencies / caches
node_modules/
.venv/
__pycache__/
*.pyc

# Secrets — never commit
.env
.env.*
*.pem
*.key
credentials*.json
token*.json

# OS / editor
.DS_Store
Thumbs.db
desktop.ini
.vscode/

# HyperFrames working artifacts and duplicated source audio
**/.hyperframes/
episodes/*/src/assets/voiceover.mp3
episodes/*/qa/render_*.log
episodes/*/qa/render_*.time
episodes/*/qa/check.json
episodes/*/qa/check.err
episodes/*/qa/align.log
