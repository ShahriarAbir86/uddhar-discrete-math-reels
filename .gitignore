# Generated renders (final MP4s go to the Google Drive delivery folder, not Git)
episodes/*/renders/**
!episodes/*/renders/.gitkeep
*.mp4
*.mov
*.png.tmp
frames/

# Dependencies / caches
node_modules/
.venv/
__pycache__/
*.pyc

# Secrets — never commit
.env
.env.*
*.pem
*.key
credentials*.json
token*.json

# OS / editor
.DS_Store
Thumbs.db
desktop.ini
.vscode/

# HyperFrames working artifacts and duplicated source audio
**/.hyperframes/
episodes/*/src/assets/voiceover.mp3
episodes/*/qa/render_*.log
episodes/*/qa/render_*.time
episodes/*/qa/check.json
episodes/*/qa/check.err
episodes/*/qa/align.log
episodes/EP02-*/renders/
episodes/EP02-*/Voiceover.mp3
episodes/EP02-*/src/assets/voiceover.mp3
episodes/EP02-*/qa/render_*.log
episodes/EP02-*/qa/render_*.time
preview/config.local.json
preview/data.json
preview/index.html
styles/animation-story/assets/*.png
episodes/EP01-*story-dark/renders/
episodes/EP01-*story-dark/src/assets/voiceover.mp3
episodes/EP01-*story-dark/qa/render_*.log
episodes/EP01-*story-dark/qa/render_*.time
