[
 {
  "scene": 1,
  "sentence": 0,
  "text": "রাত ১১টা ৪৫।",
  "start": 0.0,
  "end": 2.16
 },
 {
  "scene": 1,
  "sentence": 1,
  "text": "Assignment submission-এর ডেডলাইন রাত ১২টা।",
  "start": 2.62,
  "end": 5.12
 },
 {
  "scene": 1,
  "sentence": 2,
  "text": "কিন্তু তুমি এখনো ডেডলাইন চেক করোনি।",
  "start": 5.65,
  "end": 7.68
 },
 {
  "scene": 1,
  "sentence": 3,
  "text": "তোমার মাথায় একটাই চিন্তা।",
  "start": 8.31,
  "end": 9.81
 },
 {
  "scene": 1,
  "sentence": 4,
  "text": "স্টিল হ্যাভ টাইম।",
  "start": 10.3,
  "end": 11.39
 },
 {
  "scene": 2,
  "sentence": 5,
  "text": "এবার একটা স্টেটমেন্ট চিন্তা করো।",
  "start": 12.06,
  "end": 13.48
 },
 {
  "scene": 2,
  "sentence": 6,
  "text": "তুমি যদি ডেডলাইন চেক না করো,",
  "start": 13.97,
  "end": 15.72
 },
 {
  "scene": 2,
  "sentence": 6,
  "text": "তাহলে ধরে নাও এখনো সময় আছে।",
  "start": 16.05,
  "end": 17.93
 },
 {
  "scene": 2,
  "sentence": 7,
  "text": "এই কথাটাকে লজিক দিয়ে কীভাবে প্রকাশ করবে?",
  "start": 18.43,
  "end": 21.21
 },
 {
  "scene": 3,
  "sentence": 8,
  "text": "প্রথমে দুইটা ছোট প্রপোজিশন ডিফাইন করি।",
  "start": 21.74,
  "end": 24.04
 },
 {
  "scene": 3,
  "sentence": 9,
  "text": "পি মানে,",
  "start": 24.51,
  "end": 25.02
 },
 {
  "scene": 3,
  "sentence": 9,
  "text": "তুমি ডেডলাইন চেক করেছো।",
  "start": 25.31,
  "end": 26.62
 },
 {
  "scene": 3,
  "sentence": 10,
  "text": "আর কিউ মানে,",
  "start": 26.98,
  "end": 27.76
 },
 {
  "scene": 3,
  "sentence": 10,
  "text": "তুমি মনে করছো এখনো সময় আছে।",
  "start": 28.08,
  "end": 30.11
 },
 {
  "scene": 3,
  "sentence": 11,
  "text": "তাহলে ডেডলাইন চেক করোনি মানে।",
  "start": 30.53,
  "end": 33.17
 },
 {
  "scene": 3,
  "sentence": 12,
  "text": "নট পি।",
  "start": 33.31,
  "end": 33.62
 },
 {
  "scene": 4,
  "sentence": 13,
  "text": "আমাদের স্টেটমেন্ট ছিল,",
  "start": 34.05,
  "end": 35.21
 },
 {
  "scene": 4,
  "sentence": 13,
  "text": "তুমি যদি ডেডলাইন চেক না করো,",
  "start": 35.55,
  "end": 37.29
 },
 {
  "scene": 4,
  "sentence": 13,
  "text": "তাহলে মনে করো এখনো সময় আছে।",
  "start": 37.57,
  "end": 39.6
 },
 {
  "scene": 4,
  "sentence": 14,
  "text": "তাই এর লজিক্যাল এক্সপ্রেশন হবে।",
  "start": 39.99,
  "end": 42.71
 },
 {
  "scene": 4,
  "sentence": 15,
  "text": "নট পি ইমপ্লাইজ কিউ।",
  "start": 42.84,
  "end": 43.89
 },
 {
  "scene": 4,
  "sentence": 16,
  "text": "অর্থাৎ,",
  "start": 44.22,
  "end": 44.64
 },
 {
  "scene": 4,
  "sentence": 16,
  "text": "নট পি অ্যারো কিউ।",
  "start": 44.88,
  "end": 46.45
 },
 {
  "scene": 5,
  "sentence": 17,
  "text": "এখন আসি দুইটা গুরুত্বপূর্ণ কনসেপ্টে।",
  "start": 46.83,
  "end": 48.98
 },
 {
  "scene": 5,
  "sentence": 18,
  "text": "অরিজিনাল স্টেটমেন্টের কনভার্স করতে হলে দুই পাশের পজিশন বদলে দাও।",
  "start": 49.37,
  "end": 53.23
 },
 {
  "scene": 5,
  "sentence": 19,
  "text": "তাহলে হবে।",
  "start": 53.57,
  "end": 54.21
 },
 {
  "scene": 5,
  "sentence": 20,
  "text": "কিউ ইমপ্লাইজ নট পি।",
  "start": 54.48,
  "end": 56.24
 },
 {
  "scene": 5,
  "sentence": 21,
  "text": "আর কনট্রাপজিটিভ করতে হলে দুই পাশের প্রপোজিশন নেগেট করে পজিশন বদলাতে হবে।",
  "start": 56.61,
  "end": 61.42
 },
 {
  "scene": 5,
  "sentence": 22,
  "text": "তাহলে হবে।",
  "start": 61.74,
  "end": 62.38
 },
 {
  "scene": 5,
  "sentence": 23,
  "text": "নট কিউ ইমপ্লাইজ পি।",
  "start": 62.64,
  "end": 64.43
 },
 {
  "scene": 6,
  "sentence": 24,
  "text": "মজার ব্যাপার হলো।",
  "start": 64.88,
  "end": 65.95
 },
 {
  "scene": 6,
  "sentence": 25,
  "text": "অরিজিনাল স্টেটমেন্ট আর তার কনট্রাপজিটিভ সবসময় লজিক্যালি ইকুইভ্যালেন্ট।",
  "start": 66.27,
  "end": 70.76
 },
 {
  "scene": 6,
  "sentence": 26,
  "text": "কিন্তু কনভার্সের ক্ষেত্রে এই ইকুইভ্যালেন্স নিশ্চিত নয়।",
  "start": 71.09,
  "end": 74.03
 },
 {
  "scene": 6,
  "sentence": 27,
  "text": "এই পার্থক্যটাই মনে রাখতে হবে।",
  "start": 74.38,
  "end": 76.01
 },
 {
  "scene": 7,
  "sentence": 28,
  "text": "প্রোগ্রামিংয়ে আই-এফ কন্ডিশন বা ডিসিশন মেকিং বুঝতেও এই ধরনের লজিক্যাল রিজনিং কাজে লাগে।",
  "start": 76.45,
  "end": 81.68
 },
 {
  "scene": 8,
  "sentence": 29,
  "text": "এবার তোমার চ্যালেঞ্জ।",
  "start": 82.03,
  "end": 83.25
 },
 {
  "scene": 8,
  "sentence": 30,
  "text": "তুমি যদি ডেডলাইন চেক করো,",
  "start": 83.62,
  "end": 85.03
 },
 {
  "scene": 8,
  "sentence": 30,
  "text": "তাহলে আর মনে করবে না যে এখনো সময় আছে।",
  "start": 85.28,
  "end": 87.79
 },
 {
  "scene": 8,
  "sentence": 31,
  "text": "পি আর কিউ দিয়ে স্টেটমেন্টটা লেখো।",
  "start": 88.19,
  "end": 90.08
 },
 {
  "scene": 8,
  "sentence": 32,
  "text": "অ্যানসার কী?",
  "start": 91.1,
  "end": 91.65
 },
 {
  "scene": 8,
  "sentence": 33,
  "text": "সঠিক উত্তর।",
  "start": 92.21,
  "end": 93.0
 },
 {
  "scene": 8,
  "sentence": 34,
  "text": "পি ইমপ্লাইজ নট কিউ।",
  "start": 93.33,
  "end": 95.24
 }
